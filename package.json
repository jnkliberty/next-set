{
  "name": "workout-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "start": "node server/main.js",
    "dev": "vite --host 127.0.0.1",
    "demo": "node scripts/demo.js",
    "build": "node scripts/dependency-notices.js && tsc --noEmit && vite build && node scripts/build-worker.js"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
